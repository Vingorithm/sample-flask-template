# Copy to .env and fill in. Never commit .env.
# The setup scripts copy this file and generate SECRET_KEY for you.

# --- App -------------------------------------------------------------
APP_NAME="Flask App"
# development | testing | production
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
SESSION_LIFETIME_HOURS=12
MAX_UPLOAD_MB=16

# Dev only: enables the reloader/debugger for `flask run`. Remove in production.
FLASK_DEBUG=1
# Dev only: `flask run` also starts the Tailwind watcher. Set false to run `npm run dev` yourself.
TAILWIND_WATCH=true

# --- Database ----------------------------------------------------------
# Development: empty = SQLite at instance/dev.db
# Production: either set DATABASE_URL, or fill in the DB_* values below.
DATABASE_URL=
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/appdb?charset=utf8mb4

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Seconds; must be lower than MySQL wait_timeout.
DB_POOL_RECYCLE=280
# Keep >= WAITRESS_THREADS.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
# Defaults to true in production, false otherwise.
LOG_TO_FILE=
LOG_DIR=
LOG_MAX_MB=10
LOG_BACKUP_COUNT=10

# --- Waitress (production, behind Apache) ------------------------------
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=8000
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=100
WAITRESS_CHANNEL_TIMEOUT=120
# IP Apache connects from (same machine = 127.0.0.1).
WAITRESS_TRUSTED_PROXY=127.0.0.1
# Set e.g. /myapp if Apache mounts the app under a sub-path.
WAITRESS_URL_PREFIX=
